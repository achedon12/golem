#!/usr/bin/env php
<?php

declare(strict_types=1);

if (PHP_VERSION_ID < 80100) {
    fwrite(STDERR, "Golem needs PHP 8.1 or newer to run (found " . PHP_VERSION . ").\n");
    exit(2);
}

$packageRoot = dirname(__DIR__);

// No Composer autoloader on purpose: the CLI works the same from vendor/bin,
// a git clone or the GitHub Action, and never clashes with your dependencies.
spl_autoload_register(static function (string $class) use ($packageRoot): void {
    if (str_starts_with($class, 'Golem\\Cli\\')) {
        $file = $packageRoot . '/src/' . str_replace('\\', '/', substr($class, strlen('Golem\\'))) . '.php';
        if (is_file($file)) {
            require $file;
        }
    }
});

exit((new Golem\Cli\Application($packageRoot))->run($argv));
